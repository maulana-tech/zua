# Zcash network: "main" (mainnet) or "test" (testnet / local regtest).
NEXT_PUBLIC_ZCASH_NETWORK=main
# gRPC-web proxy in front of lightwalletd. Plain lightwalletd URLs (e.g.
# https://zec.rocks) do not work from a browser. Testnet/regtest: run your own
# proxy (see WebZjs docker-compose or ZecKit).
NEXT_PUBLIC_LIGHTWALLETD_URL=https://zcash-mainnet.chainsafe.dev
# Optional explorer link for transactions; {txid} is replaced.
NEXT_PUBLIC_ZCASH_EXPLORER_TX_URL=
NEXT_PUBLIC_MIN_CONFIRMATIONS=3

NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

MONGODB_URI=mongodb://localhost:27017/zcash-app
CRON_SECRET=replace-with-a-long-random-secret

# Email notifications (Resend). Leave empty to run without email notifications.
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=
