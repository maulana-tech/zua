# Zcash network: "main" (mainnet) or "test" (testnet, free TAZ from a faucet).
NEXT_PUBLIC_ZCASH_NETWORK=main
# Optional overrides. Defaults: ChainSafe's gRPC-web proxy for the chosen
# network; explorer links go to mainnet.zcashexplorer.app on mainnet and
# testnet.shieldedscan.xyz on testnet (testnet.zcashexplorer.app is on a chain
# that split at NU7, so testnet transactions aren't found there). Plain
# lightwalletd URLs (e.g. https://zec.rocks) do not work from a browser.
NEXT_PUBLIC_LIGHTWALLETD_URL=
# Explorer link for transactions; {txid} is replaced.
NEXT_PUBLIC_ZCASH_EXPLORER_TX_URL=
NEXT_PUBLIC_MIN_CONFIRMATIONS=3

NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

MONGODB_URI=mongodb://localhost:27017/zcash-app
CRON_SECRET=replace-with-a-long-random-secret

# Email notifications (Resend). Leave empty to run without email notifications.
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=
